# Public site URL. Used for canonical links, sitemap, and Paystack callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local Postgres started by `npm run db:setup`.
# On Supabase, replace this with the project connection string (server only).
DATABASE_URL=postgres://hood:hood_local_password@127.0.0.1:54351/hoodboyz

# Long random string. Pepper for session and token hashes. Server only.
SESSION_SECRET=replace-with-a-long-random-string

# First super administrator. Used only by `npm run db:seed` when none exists.
INITIAL_ADMIN_EMAIL=admin@hoodboyz.local
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# Supabase Auth and Storage. Leave blank to use local accounts and local uploads.
# The database URL above must point at the same Supabase project when these are set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack. Amounts are sent in pesewas. Never expose the secret key to the browser.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Paystack signs webhooks with the secret key. Set this only if you use a separate secret.
PAYSTACK_WEBHOOK_SECRET=

# Stripe is wired but inactive until these are set.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional transactional email. Without this, development shows verification links on screen.
RESEND_API_KEY=
EMAIL_FROM=
